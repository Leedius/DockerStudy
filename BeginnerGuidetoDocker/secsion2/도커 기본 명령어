docker rm mysql
docker run -d -p 3307:3307 -e MYSQL_ALLOW_EMPTY_PASSWORD=true --network=app-network --name mysql -v C:/Users/user/Desktop/dev/Study/docker/BeginnerGuidetoDocker/secsion2/mysql:/var/lib/mysql mysql:5.7

